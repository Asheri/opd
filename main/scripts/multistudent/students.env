# 多学生并发训练 —— 三档学生定义（按 GPU_MEMORY_AND_PARALLEL_PLAN.md §7 打包）
#
# 2×RTX PRO 6000（96GB×2）打包：
#   cuda:0 ← 7B（8-bit-Adam learner 76GB + scorer 15GB ≈ 91GB）
#   cuda:1 ← 4B（8-bit-Adam 39GB）+ 1.7B（fp32-Adam 28GB）≈ 78GB
# 真实 HF 路径在 models.env 或下方覆盖；SMOKE=1 时用 toy 内核 + CPU 验证编排逻辑。
#
# 用法：bash run_all.sh [smoke|real]

# ---- 三档学生（real 模式）：模型路径 / 设备 / 缓存 / run 目录 / 每档配置 ----
# 与 benchmarks/aime24_25/models.env 对齐；实际 HF id 以服务器下载为准。
STUDENT_7B_PATH="Qwen/Qwen3-R1-Distill-7B"     # 或 DeepSeek-R1-Distill-Qwen-7B
STUDENT_4B_PATH="Qwen/Qwen3-4B"
STUDENT_17B_PATH="Qwen/Qwen3-1.7B"

# 教师对（Stage 0 跳过时由预建缓存提供 Δ_T；仅建缓存阶段需要）
TEACHER_RL_PATH="JustRL-DeepSeek-1.5B"
TEACHER_REF_PATH="DeepSeek-R1-Distill-Qwen-1.5B"

# 工作根目录（缓存 + run 目录 + 评估产出）
WORK_ROOT="${WORK_ROOT:-/shared/opd_multistudent}"
mkdir -p "$WORK_ROOT"

# 三档：名称 / 模型路径 / device / 缓存文件 / run 目录 / batch
declare -A S_NAME=( [7b]=combo3_r1_distill_7b [4b]=combo2_qwen3_4b [17b]=combo1_qwen3_1p7b )
declare -A S_PATH=( [7b]="$STUDENT_7B_PATH" [4b]="$STUDENT_4B_PATH" [17b]="$STUDENT_17B_PATH" )
declare -A S_DEV=(  [7b]="cuda:0"            [4b]="cuda:1"            [17b]="cuda:1" )
declare -A S_CACHE=( [7b]="$WORK_ROOT/cache_7b.pt" [4b]="$WORK_ROOT/cache_4b.pt" [17b]="$WORK_ROOT/cache_17b.pt" )
declare -A S_RUN=(   [7b]="$WORK_ROOT/runs/7b"    [4b]="$WORK_ROOT/runs/4b"    [17b]="$WORK_ROOT/runs/17b" )
declare -A S_BATCH=( [7b]="8"                    [4b]="16"                   [17b]="16" )
declare -A S_NSTEPS=([7b]="1000"                  [4b]="1000"                 [17b]="1000" )
declare -A S_EVALOUT=([7b]="$WORK_ROOT/eval/student_post/combo3" \
                      [4b]="$WORK_ROOT/eval/student_post/combo2" \
                      [17b]="$WORK_ROOT/eval/student_post/combo1" )
STUDENTS="7b 4b 17b"
